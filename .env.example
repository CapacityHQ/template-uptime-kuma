# Uptime Kuma reads this file when the server starts (dotenv). Capacity Desktop copies it to
# .env when the project is created, and .env is never committed.

# Keep everything in SQLite under DATA_DIR and skip the database setup page.
# MariaDB is the other option (UPTIME_KUMA_DB_HOSTNAME, _PORT, _NAME, _USERNAME, _PASSWORD).
UPTIME_KUMA_DB_TYPE=sqlite

# Where the SQLite database, the uploads and the screenshots live; the folder is gitignored.
# Without it a development server keeps its data under data/dev-data/<git branch>/, a path
# that changes with the branch the project is on.
DATA_DIR=./data/

# Everything else is optional and documented in upstream's wiki, "Environment Variables".
# UPTIME_KUMA_PORT (default 3001) is the server's port; the development frontend on port 3000
# expects 3001. UPTIME_KUMA_HOST binds the server to one address (unset, every interface).
